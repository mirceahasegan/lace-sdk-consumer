{
  "name": "lace-sdk-consumer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit --moduleResolution bundler --module esnext --target es2022 --skipLibCheck tests/e2e/*.ts tests/live/*.ts playwright.midnight-live.config.ts playwright.runtime.config.ts playwright.config.ts vite.config.ts sponsor-relay.ts",
    "test": "node --import ./tests/support/register.mjs --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:runtime:production": "playwright test --config playwright.runtime.config.ts",
    "dev": "vite",
    "preview": "vite preview",
    "test:midnight:live": "playwright test --config playwright.midnight-live.config.ts"
  },
  "dependencies": {
    "@input-output-hk/temenos-attestation-verifier": "file:vendor/input-output-hk-temenos-attestation-verifier-0.3.0.tgz",
    "@laceio/sdk": "file:vendor/laceio-sdk-0.1.0.tgz",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnightntwrk/wallet-sdk": "1.2.0",
    "@midnightntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnightntwrk/wallet-sdk-address-format": "3.1.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "assert": "2.1.0",
    "buffer": "^6.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk-address-format@3.1.2": {
      "@scure/base": "2.2.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2"
  }
}
